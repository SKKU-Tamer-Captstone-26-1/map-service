Project map_place_service_erd_v0_2 {
  database_type: 'PostgreSQL'
  Note: 'Map / Place Service canonical database ERD v0.2. Admin Page is a privileged API client, not a data owner. Recommendation Service consumes published snapshots/events only. Kakao data is realtime/restricted unless explicitly approved.'
}

// ============================================================
// ENUMS
// ============================================================

Enum source_type {
  OPERATOR
  OWNER
  FIELD_RESEARCH
  PUBLIC_DATA
  KAKAO
  USER_REPORT
  SYSTEM
}

Enum source_policy {
  STORABLE
  REALTIME_ONLY
  RESTRICTED
}

Enum import_type {
  PUBLIC_DATA_FILE
  PUBLIC_DATA_API
  FIELD_RESEARCH_FILE
  OWNER_SUBMISSION
  OPERATOR_MANUAL
  USER_REPORT
  KAKAO_REALTIME_REFERENCE
}

Enum import_status {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

Enum candidate_match_status {
  NEW_CANDIDATE
  POSSIBLE_DUPLICATE
  MATCHED_EXISTING
  REJECTED
  NEEDS_REVIEW
}

Enum candidate_review_status {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  MERGED
  SKIPPED
}

Enum dedupe_match_status {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED
}

Enum review_task_type {
  VERIFY_NEW_PLACE
  VERIFY_DUPLICATE
  VERIFY_CLOSED
  VERIFY_LOCATION
  VERIFY_SOURCE_CONFLICT
  REVIEW_OWNER_CHANGE
  REVIEW_USER_REPORT
}

Enum review_task_status {
  PENDING
  ASSIGNED
  RESOLVED
  CANCELLED
}

Enum place_type {
  BAR
  PUB
  LIQUOR_SHOP
  BOTTLE_SHOP
  RESTAURANT
  OUTDOOR_SPOT
  CONVENIENCE_STORE
  OTHER
}

Enum place_status {
  DRAFT
  ACTIVE
  HIDDEN
  TEMPORARILY_CLOSED
  CLOSED
  DUPLICATE_MERGED
  REJECTED
  ARCHIVED
}

Enum publication_status {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

Enum verified_level {
  UNVERIFIED
  OWNER_VERIFIED
  OPERATOR_VERIFIED
}

Enum media_type {
  REPRESENTATIVE
  INTERIOR
  EXTERIOR
  MENU
  EVENT
  OWNER_PROOF
}

Enum media_status {
  ACTIVE
  HIDDEN
  REJECTED
  DELETED
}

Enum claim_status {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REVOKED
}

Enum manager_role {
  OWNER
  MANAGER
  STAFF
}

Enum manager_status {
  ACTIVE
  SUSPENDED
  REVOKED
}

Enum requester_role {
  OWNER
  MANAGER
  STAFF
  OPERATOR
  SYSTEM
}

Enum change_type {
  NAME
  ADDRESS
  LOCATION
  PLACE_TYPE
  CLOSE
  REOPEN
  OWNERSHIP_TRANSFER
  MERGE_REQUEST
  PUBLICATION_STATUS
  RECOMMENDATION_ELIGIBILITY
}

Enum request_status {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

Enum actor_role {
  OPERATOR
  OWNER
  MANAGER
  STAFF
  USER
  SYSTEM
  INGESTION_WORKER
  ANONYMOUS
}

Enum audit_action {
  PLACE_CREATED
  PLACE_UPDATED
  PLACE_PUBLISHED
  PLACE_UNPUBLISHED
  PLACE_CLOSED
  PLACE_HIDDEN
  PLACE_MERGED
  SOURCE_LINKED
  MENU_CREATED
  MENU_UPDATED
  INVENTORY_UPDATED
  PRICE_UPDATED
  CLAIM_APPROVED
  CLAIM_REJECTED
  CHANGE_REQUEST_CREATED
  CHANGE_REQUEST_APPROVED
  OVERRIDE_CREATED
  OVERRIDE_DISABLED
  IMPORT_BATCH_CREATED
  IMPORT_CANDIDATE_REVIEWED
}

Enum audit_target_type {
  PLACE
  SOURCE_REF
  MENU_ITEM
  INVENTORY_ITEM
  PRICE_OFFER
  CLAIM
  CHANGE_REQUEST
  OVERRIDE
  IMPORT_BATCH
  IMPORT_CANDIDATE
  REVIEW_TASK
}

Enum report_type {
  CLOSED
  WRONG_ADDRESS
  WRONG_LOCATION
  WRONG_PRICE
  OUT_OF_STOCK
  DUPLICATE
  INAPPROPRIATE
  OTHER
}

Enum report_status {
  PENDING
  REVIEWING
  RESOLVED
  REJECTED
}

Enum tag_type {
  ATMOSPHERE
  AMENITY
  CATEGORY
  LOCAL
  RECOMMENDATION
}

Enum menu_type {
  BOTTLE
  GLASS
  COCKTAIL
  BEER
  WINE
  WHISKEY
  FOOD
  FOOD_PAIRING
  CORKAGE
  EVENT
}

Enum item_status {
  ACTIVE
  HIDDEN
  DISCONTINUED
  PENDING_REVIEW
}

Enum availability_status {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  UNKNOWN
  DISCONTINUED
}

Enum price_type {
  BOTTLE
  GLASS
  COCKTAIL
  CORKAGE
  SET
  EVENT
  HAPPY_HOUR
  DELIVERY
  PICKUP
}

Enum outdoor_level {
  NONE
  LOW
  MEDIUM
  HIGH
  VARIES
}

Enum outbox_status {
  PENDING
  PUBLISHED
  FAILED
  SKIPPED
}

Enum travel_mode {
  WALK
  CAR
  TRANSIT
  MIXED
}

// ============================================================
// A. SOURCE / IMPORT / STAGING
// ============================================================

Table data_sources {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  source_type source_type [not null]
  source_name text [not null]
  source_policy source_policy [not null]
  license_name text
  license_url text
  trust_level smallint [not null, default: 0, note: 'Higher means more trustworthy. Operator data should outrank realtime external data.']
  active boolean [not null, default: true]
  metadata_json jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    source_type [name: 'idx_data_sources_type']
    source_policy [name: 'idx_data_sources_policy']
    (source_type, source_name) [unique, name: 'uq_data_sources_type_name']
  }
}

Table place_import_batches {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  source_id uuid [not null]
  import_type import_type [not null]
  file_name text
  original_uri text
  status import_status [not null, default: 'PENDING']
  started_at timestamptz
  completed_at timestamptz
  row_count integer [not null, default: 0]
  success_count integer [not null, default: 0]
  error_count integer [not null, default: 0]
  checksum_sha256 text
  metadata_json jsonb [not null, default: '{}']
  created_by_user_id text [note: 'auth-service user id. No cross-service FK.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    source_id [name: 'idx_import_batches_source']
    status [name: 'idx_import_batches_status']
    created_at [name: 'idx_import_batches_created_at']
  }
}

Table place_import_candidates {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  batch_id uuid [not null]
  source_id uuid [not null]
  external_source_id text
  source_policy source_policy [not null]
  raw_payload_json jsonb [not null]
  normalized_name text
  normalized_address text
  source_category_name text
  candidate_place_type place_type
  location geography [note: 'PostGIS Point(4326). Create GiST index in SQL migration.']
  latitude numeric(10,7)
  longitude numeric(10,7)
  match_status candidate_match_status [not null, default: 'NEW_CANDIDATE']
  matched_place_id uuid
  dedupe_confidence numeric(4,3)
  review_status candidate_review_status [not null, default: 'PENDING']
  rejection_reason text
  metadata_json jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    batch_id [name: 'idx_import_candidates_batch']
    (source_id, external_source_id) [name: 'idx_import_candidates_source_external']
    normalized_name [name: 'idx_import_candidates_normalized_name']
    normalized_address [name: 'idx_import_candidates_normalized_address']
    match_status [name: 'idx_import_candidates_match_status']
    review_status [name: 'idx_import_candidates_review_status']
    matched_place_id [name: 'idx_import_candidates_matched_place']
  }
}

Table place_dedupe_matches {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  candidate_id uuid [not null]
  existing_place_id uuid [not null]
  match_strategy text [not null, note: 'name_address, name_distance, source_external_id, manual, etc.']
  confidence numeric(4,3) [not null]
  status dedupe_match_status [not null, default: 'PENDING']
  decided_by_user_id text [note: 'auth-service user id. No cross-service FK.']
  decided_at timestamptz
  decision_note text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    candidate_id [name: 'idx_dedupe_matches_candidate']
    existing_place_id [name: 'idx_dedupe_matches_place']
    status [name: 'idx_dedupe_matches_status']
    confidence [name: 'idx_dedupe_matches_confidence']
  }
}

Table place_review_tasks {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  candidate_id uuid
  place_id uuid
  task_type review_task_type [not null]
  priority integer [not null, default: 100]
  status review_task_status [not null, default: 'PENDING']
  assigned_to_user_id text [note: 'auth-service user id. No cross-service FK.']
  resolution_json jsonb [not null, default: '{}']
  resolution_note text
  created_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    status [name: 'idx_review_tasks_status']
    (status, priority, created_at) [name: 'idx_review_tasks_queue']
    candidate_id [name: 'idx_review_tasks_candidate']
    place_id [name: 'idx_review_tasks_place']
  }
}

// ============================================================
// B. CORE PLACE
// ============================================================

Table places {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  place_type place_type [not null]
  canonical_name text [not null]
  normalized_name text [not null]
  status place_status [not null, default: 'DRAFT']
  publication_status publication_status [not null, default: 'DRAFT']
  address text
  road_address text
  address_detail text
  location geography [note: 'PostGIS Point(4326). Create GiST index in SQL migration.']
  latitude numeric(10,7)
  longitude numeric(10,7)
  geohash text
  phone text
  website_url text
  instagram_url text
  price_level smallint [note: '1 to 5. Nullable when unknown.']
  verified_level verified_level [not null, default: 'UNVERIFIED']
  recommendation_eligible boolean [not null, default: true]
  created_by_source_id uuid
  created_by_actor_user_id text [note: 'auth-service user id. No cross-service FK.']
  merged_into_place_id uuid
  revision bigint [not null, default: 1]
  published_at timestamptz
  closed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    normalized_name [name: 'idx_places_normalized_name']
    geohash [name: 'idx_places_geohash']
    (status, publication_status, place_type) [name: 'idx_places_public_query']
    (place_type, recommendation_eligible) [name: 'idx_places_recommendation_query']
    created_by_source_id [name: 'idx_places_created_by_source']
    merged_into_place_id [name: 'idx_places_merged_into']
  }
}

Table place_source_refs {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  place_id uuid [not null]
  source_id uuid [not null]
  external_source_id text
  external_url text
  source_policy source_policy [not null]
  match_confidence numeric(4,3)
  is_primary boolean [not null, default: false]
  last_checked_at timestamptz
  metadata_json jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    place_id [name: 'idx_place_source_refs_place']
    (source_id, external_source_id) [unique, name: 'uq_place_source_refs_source_external']
    is_primary [name: 'idx_place_source_refs_primary']
  }
}

Table place_business_hours {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  place_id uuid [not null]
  day_of_week smallint [not null, note: '0 Sunday, 1 Monday, ... 6 Saturday']
  opens_at time
  closes_at time
  is_closed boolean [not null, default: false]
  source_type source_type [not null]
  last_verified_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (place_id, day_of_week) [unique, name: 'uq_business_hours_place_day']
  }
}

Table place_special_hours {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  place_id uuid [not null]
  target_date date [not null]
  opens_at time
  closes_at time
  status text [not null, note: 'open, closed, shortened, extended, unknown']
  note text
  source_type source_type [not null]
  last_verified_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (place_id, target_date) [unique, name: 'uq_special_hours_place_date']
  }
}

Table tags {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  tag_type tag_type [not null]
  code text [not null, unique]
  name_ko text [not null]
  name_en text
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    tag_type [name: 'idx_tags_type']
    code [unique, name: 'uq_tags_code']
  }
}

Table place_tags {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  place_id uuid [not null]
  tag_id uuid [not null]
  source_type source_type [not null]
  confidence numeric(4,3)
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (place_id, tag_id) [unique, name: 'uq_place_tags_place_tag']
    tag_id [name: 'idx_place_tags_tag']
  }
}

Table place_media {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  place_id uuid [not null]
  media_type media_type [not null]
  storage_url text [not null]
  thumbnail_url text
  caption text
  display_order integer [not null, default: 0]
  status media_status [not null, default: 'ACTIVE']
  uploaded_by_user_id text [note: 'auth-service user id. No cross-service FK.']
  uploaded_by_role actor_role
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (place_id, status, display_order) [name: 'idx_place_media_display']
  }
}

// ============================================================
// C. ADMIN / OWNERSHIP / GOVERNANCE
// ============================================================

Table business_claims {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  place_id uuid [not null]
  requester_user_id text [not null, note: 'auth-service user id. No cross-service FK.']
  requester_name text
  requester_phone text
  claim_status claim_status [not null, default: 'PENDING']
  business_registration_no_hash text
  evidence_document_refs jsonb [not null, default: '[]']
  requested_at timestamptz [not null, default: `now()`]
  reviewed_by_user_id text
  reviewed_at timestamptz
  rejection_reason text
  metadata_json jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    place_id [name: 'idx_business_claims_place']
    requester_user_id [name: 'idx_business_claims_requester']
    claim_status [name: 'idx_business_claims_status']
  }
}

Table place_managers {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  place_id uuid [not null]
  user_id text [not null, note: 'auth-service user id. No cross-service FK.']
  manager_role manager_role [not null]
  status manager_status [not null, default: 'ACTIVE']
  granted_by_user_id text
  granted_reason text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz

  Indexes {
    (place_id, user_id) [unique, name: 'uq_place_managers_place_user']
    (user_id, status) [name: 'idx_place_managers_user_status']
    (place_id, status) [name: 'idx_place_managers_place_status']
  }
}

Table place_change_requests {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  place_id uuid [not null]
  requested_by_user_id text [not null, note: 'auth-service user id. No cross-service FK.']
  requester_role requester_role [not null]
  change_type change_type [not null]
  current_value_json jsonb
  requested_value_json jsonb [not null]
  status request_status [not null, default: 'PENDING']
  reviewed_by_user_id text
  reviewed_at timestamptz
  review_note text
  idempotency_key text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    place_id [name: 'idx_change_requests_place']
    (status, change_type, created_at) [name: 'idx_change_requests_queue']
    idempotency_key [name: 'idx_change_requests_idempotency']
  }
}

Table place_overrides {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  place_id uuid [not null]
  field_name text [not null]
  override_value_json jsonb [not null]
  reason text [not null]
  priority integer [not null, default: 100]
  active boolean [not null, default: true]
  created_by_user_id text [not null, note: 'auth-service user id. No cross-service FK.']
  expires_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (place_id, field_name, active) [name: 'idx_place_overrides_active_field']
  }
}

Table place_audit_logs {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  actor_user_id text [note: 'auth-service user id. No cross-service FK.']
  actor_role actor_role
  action audit_action [not null]
  target_type audit_target_type [not null]
  target_id uuid [not null]
  before_json jsonb
  after_json jsonb
  request_id text
  ip_address inet
  user_agent text
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (target_type, target_id, created_at) [name: 'idx_audit_logs_target']
    (actor_user_id, created_at) [name: 'idx_audit_logs_actor']
    action [name: 'idx_audit_logs_action']
  }
}

Table place_reports {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  place_id uuid [not null]
  reporter_user_id text [note: 'auth-service user id. No cross-service FK.']
  reporter_type actor_role [not null]
  report_type report_type [not null]
  report_payload_json jsonb [not null, default: '{}']
  status report_status [not null, default: 'PENDING']
  reviewed_by_user_id text
  reviewed_at timestamptz
  resolution_note text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    place_id [name: 'idx_place_reports_place']
    (status, report_type, created_at) [name: 'idx_place_reports_queue']
  }
}

// ============================================================
// D. MENU / INVENTORY / PRICE
// ============================================================

Table venue_menu_items {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  place_id uuid [not null]
  beverage_catalog_ref_id text [note: 'recommendation-service or catalog-service beverage id. No cross-service FK.']
  menu_name text [not null]
  normalized_menu_name text [not null]
  menu_type menu_type [not null]
  description text
  base_price_krw integer
  is_signature boolean [not null, default: false]
  status item_status [not null, default: 'ACTIVE']
  source_type source_type [not null]
  confidence numeric(4,3)
  last_verified_at timestamptz
  revision bigint [not null, default: 1]
  created_by_user_id text [note: 'auth-service user id. No cross-service FK.']
  updated_by_user_id text [note: 'auth-service user id. No cross-service FK.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (place_id, status) [name: 'idx_menu_items_place_status']
    beverage_catalog_ref_id [name: 'idx_menu_items_beverage_ref']
    normalized_menu_name [name: 'idx_menu_items_normalized_name']
    is_signature [name: 'idx_menu_items_signature']
  }
}

Table venue_inventory_items {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  place_id uuid [not null]
  menu_item_id uuid
  beverage_catalog_ref_id text [note: 'recommendation-service or catalog-service beverage id. No cross-service FK.']
  inventory_name text [note: 'Raw owner/operator name when beverage ref is not mapped yet.']
  availability_status availability_status [not null, default: 'UNKNOWN']
  stock_confidence numeric(4,3) [not null, default: 0.500]
  quantity_text text
  last_seen_at timestamptz
  expires_at timestamptz
  source_type source_type [not null]
  updated_by_role actor_role
  revision bigint [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (place_id, beverage_catalog_ref_id) [name: 'idx_inventory_place_beverage']
    (availability_status, expires_at) [name: 'idx_inventory_availability_expires']
    menu_item_id [name: 'idx_inventory_menu_item']
    expires_at [name: 'idx_inventory_expires_at']
  }
}

Table venue_price_offers {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  place_id uuid [not null]
  menu_item_id uuid
  beverage_catalog_ref_id text [note: 'recommendation-service or catalog-service beverage id. No cross-service FK.']
  price_krw integer [not null]
  currency text [not null, default: 'KRW']
  price_type price_type [not null]
  min_order_quantity integer
  note text
  valid_from timestamptz
  valid_until timestamptz
  source_type source_type [not null]
  confidence numeric(4,3) [not null, default: 0.500]
  revision bigint [not null, default: 1]
  created_by_user_id text [note: 'auth-service user id. No cross-service FK.']
  updated_by_user_id text [note: 'auth-service user id. No cross-service FK.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (place_id, beverage_catalog_ref_id) [name: 'idx_price_place_beverage']
    menu_item_id [name: 'idx_price_menu_item']
    valid_until [name: 'idx_price_valid_until']
    price_krw [name: 'idx_price_krw']
  }
}

// ============================================================
// E. OUTDOOR SPOT
// ============================================================

Table outdoor_spot_profiles {
  place_id uuid [pk, not null]
  allowed_activity_notes text
  nearby_store_notes text
  seating_level outdoor_level
  crowd_level outdoor_level
  restroom_available boolean
  parking_available boolean
  weather_sensitive boolean [not null, default: true]
  policy_notes text
  safety_notes text
  last_verified_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ============================================================
// F. EVENT / SYNC
// ============================================================

Table place_outbox_events {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  aggregate_type text [not null, note: 'place, menu_item, inventory_item, price_offer, business_claim']
  aggregate_id uuid [not null]
  aggregate_revision bigint [not null]
  event_type text [not null, note: 'place.published, place.updated, menu.updated, inventory.updated, price.updated, etc.']
  payload_json jsonb [not null]
  status outbox_status [not null, default: 'PENDING']
  idempotency_key text
  error_message text
  created_at timestamptz [not null, default: `now()`]
  published_at timestamptz

  Indexes {
    (status, created_at) [name: 'idx_outbox_pending']
    (aggregate_type, aggregate_id, aggregate_revision) [name: 'idx_outbox_aggregate']
    idempotency_key [name: 'idx_outbox_idempotency']
  }
}

// ============================================================
// G. OPTIONAL ROUTE CACHE
// ============================================================

Table route_estimate_cache {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  origin_geohash text [not null]
  destination_place_id uuid [not null]
  travel_mode travel_mode [not null]
  provider text [not null]
  distance_m integer
  duration_sec integer
  route_complexity_score numeric(4,3)
  route_summary_json jsonb [not null, default: '{}']
  fetched_at timestamptz [not null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (origin_geohash, destination_place_id, travel_mode, provider) [name: 'idx_route_cache_lookup']
    expires_at [name: 'idx_route_cache_expires_at']
  }
}

// ============================================================
// REFS
// ============================================================

Ref: place_import_batches.source_id > data_sources.id
Ref: place_import_candidates.batch_id > place_import_batches.id
Ref: place_import_candidates.source_id > data_sources.id
Ref: place_import_candidates.matched_place_id > places.id
Ref: place_dedupe_matches.candidate_id > place_import_candidates.id
Ref: place_dedupe_matches.existing_place_id > places.id
Ref: place_review_tasks.candidate_id > place_import_candidates.id
Ref: place_review_tasks.place_id > places.id

Ref: places.created_by_source_id > data_sources.id
Ref: places.merged_into_place_id > places.id
Ref: place_source_refs.place_id > places.id
Ref: place_source_refs.source_id > data_sources.id
Ref: place_business_hours.place_id > places.id
Ref: place_special_hours.place_id > places.id
Ref: place_tags.place_id > places.id
Ref: place_tags.tag_id > tags.id
Ref: place_media.place_id > places.id

Ref: business_claims.place_id > places.id
Ref: place_managers.place_id > places.id
Ref: place_change_requests.place_id > places.id
Ref: place_overrides.place_id > places.id
Ref: place_reports.place_id > places.id

Ref: venue_menu_items.place_id > places.id
Ref: venue_inventory_items.place_id > places.id
Ref: venue_inventory_items.menu_item_id > venue_menu_items.id
Ref: venue_price_offers.place_id > places.id
Ref: venue_price_offers.menu_item_id > venue_menu_items.id

Ref: outdoor_spot_profiles.place_id > places.id
Ref: route_estimate_cache.destination_place_id > places.id
