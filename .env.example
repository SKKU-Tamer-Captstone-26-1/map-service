# Local/dev PostGIS database only. Do not use these values for production.

COMPOSE_PROJECT_NAME=map-service-dev
DOCKER_DEFAULT_PLATFORM=linux/amd64

MAP_SERVICE_DB_CONTAINER=map-service-postgis-dev
MAP_SERVICE_DB_HOST=127.0.0.1
MAP_SERVICE_DB_PORT=55433
MAP_SERVICE_DB_NAME=map_service
MAP_SERVICE_DB_USER=map_user
MAP_SERVICE_DB_PASSWORD=map_pass

DATABASE_URL=postgresql://map_user:map_pass@127.0.0.1:55433/map_service
MAP_SERVICE_DATABASE_URL=postgresql://map_user:map_pass@127.0.0.1:55433/map_service

MAP_SERVICE_API_HOST=127.0.0.1
MAP_SERVICE_API_PORT=8088
MAP_SERVICE_API_CORS_ORIGIN=*
MAP_SERVICE_API_LOGS=false

# Public data API key for local dry-run fetch tools.
# Do not commit real service keys.
# Approved development APIs as of 2026-05-22, expiring 2028-05-22:
# - 소상공인시장진흥공단_상가(상권)정보_API
# - 행정안전부_식품_일반음식점 조회서비스
# - 행정안전부_식품_휴게음식점 조회서비스
# - 행정안전부_식품_단란주점영업 조회서비스
# - 행정안전부_식품_유흥주점영업 조회서비스
DATA_GO_KR_SERVICE_KEY=replace-with-local-data-go-kr-service-key
